---
import { localizeWordPressMedia } from "../utils/wordpress-media";

interface Props {
	node: {
		src?: string;
		alt?: string;
	};
}

const { src, alt = "" } = Astro.props.node;
const mediaSrc = localizeWordPressMedia(src);
---

{mediaSrc && (
	<figure class="imported-image">
		<img src={mediaSrc} alt={alt} loading="lazy" decoding="async" />
		{alt && <figcaption>{alt}</figcaption>}
	</figure>
)}

<style>
	.imported-image {
		margin-block: 1.75rem;
	}

	.imported-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
	}

	.imported-image figcaption {
		margin-top: 0.5rem;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}
</style>
