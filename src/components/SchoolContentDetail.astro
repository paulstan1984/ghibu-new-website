---
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import SchoolForm from "./SchoolForm.astro";
import WordPressImage from "./WordPressImage.astro";
import { formatDate } from "../utils/locale";

interface Props {
	collection: string;
	entry: {
		id: string;
		data: {
			id: string;
			title: string;
			excerpt?: string | null;
			content?: PortableTextBlock[] | null;
			featured_image_url?: string | null;
			source_date?: Date | string | null;
		};
	};
	formKind?: "contact" | "welcome";
}

const { collection, entry, formKind } = Astro.props;
const sourceDate = entry.data.source_date
	? new Date(entry.data.source_date)
	: null;
const validDate =
	sourceDate && Number.isFinite(sourceDate.getTime()) ? sourceDate : null;
const canonicalCollection = collection;
---

<Base
	title={entry.data.title}
	description={entry.data.excerpt || undefined}
	type={collection === "announcements" ? "article" : "website"}
	publishedTime={validDate?.toISOString()}
	content={{
		collection: canonicalCollection,
		id: entry.data.id,
		slug: entry.id,
	}}
>
	<article class="band school-entry">
		<div class="frame school-entry__layout">
			<header class="school-entry__header">
				<p class="eyebrow">
					{collection === "announcements"
						? "Anunț"
						: collection === "teachers"
							? "Profesor"
							: collection === "courses"
								? "Program educațional"
								: "Eveniment"}
				</p>
				<h1>{entry.data.title}</h1>
				{validDate && (
					<time class="school-entry__date" datetime={validDate.toISOString()}>
						{formatDate(validDate, "long")}
					</time>
				)}
			</header>
			{entry.data.featured_image_url && (
				<img
					class="school-entry__image"
					src={entry.data.featured_image_url}
					alt=""
					fetchpriority="high"
				/>
			)}
			{entry.data.excerpt && <p class="school-entry__excerpt">{entry.data.excerpt}</p>}
			<div class="prose school-entry__content">
				<PortableText
					value={entry.data.content ?? []}
					components={{ type: { wordpressImage: WordPressImage } }}
				/>
			</div>
			{formKind && <SchoolForm variant={formKind} />}
			<nav class="school-entry__back" aria-label="Navigare secundară">
				<a class="text-link" href={collection === "announcements" ? "/noutati" : "/proiecte"}>
					<span aria-hidden="true">←</span>
					{collection === "announcements" ? "Înapoi la anunțuri" : "Înapoi la activități"}
				</a>
			</nav>
		</div>
	</article>
</Base>

<style>
	.school-entry {
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}

	.school-entry__layout {
		display: grid;
		max-width: 920px;
		gap: 1.5rem;
	}

	.school-entry__header h1 {
		max-width: 24ch;
		margin-block: 0.5rem 1rem;
		font-size: clamp(2.2rem, 5vw, 4.2rem);
		line-height: 1.05;
	}

	.school-entry__date {
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.school-entry__image {
		width: 100%;
		max-height: 34rem;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
		object-fit: cover;
	}

	.school-entry__excerpt {
		color: var(--color-text-secondary);
		font-size: 1.2rem;
		line-height: 1.7;
	}

	.school-entry__content {
		max-width: var(--content-width);
		width: 100%;
		margin-inline: auto;
		padding-block: 1rem;
	}

	.school-entry__back {
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}
</style>
