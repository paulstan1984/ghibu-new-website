---
import { decodeSlug, getEmDashEntry } from "emdash";
import SchoolContentDetail from "../../components/SchoolContentDetail.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry, error, cacheHint } = await getEmDashEntry("courses", slug);
if (error) return new Response("Nu am putut încărca programul.", { status: 500 });
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<SchoolContentDetail collection="courses" entry={entry} />
