---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { formatDate } from "../utils/locale";

const { entries, error, cacheHint } = await getEmDashCollection("announcements", {
	orderBy: { source_date: "desc" },
	limit: 100,
});
if (error) {
	return new Response("Nu am putut încărca anunțurile.", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Anunțuri" description="Anunțuri și informații pentru elevi și părinți.">
	<header class="band intro">
		<div class="frame school-page-intro">
			<p class="eyebrow">Comunicări oficiale</p>
			<h1 class="intro__title">Anunțuri</h1>
			<p class="intro__lead">Informații actualizate pentru elevi, părinți și profesori.</p>
		</div>
	</header>
	<section class="band section">
		<div class="frame school-list">
			{entries.length ? entries.map((entry) => (
				<article class="school-list-card">
					{entry.data.featured_image_url && (
						<a class="school-list-card__image" href={`/noutati/${entry.id}`}>
							<img src={entry.data.featured_image_url} alt="" loading="lazy" />
						</a>
					)}
					<div>
						{entry.data.source_date && (
							<time class="eyebrow" datetime={new Date(entry.data.source_date).toISOString()}>
								{formatDate(new Date(entry.data.source_date), "long")}
							</time>
						)}
						<h2><a href={`/noutati/${entry.id}`}>{entry.data.title}</a></h2>
						{entry.data.excerpt && <p>{entry.data.excerpt}</p>}
						<a class="text-link" href={`/noutati/${entry.id}`}>Citește anunțul <span aria-hidden="true">→</span></a>
					</div>
				</article>
			)) : <p class="school-empty">Nu sunt anunțuri publicate momentan.</p>}
		</div>
	</section>
</Base>

<style>
	.school-list {
		display: grid;
		gap: 1rem;
	}

	.school-list-card {
		display: grid;
		grid-template-columns: minmax(180px, 0.32fr) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.school-list-card__image {
		display: block;
		overflow: hidden;
		align-self: start;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.school-list-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.school-list-card h2 {
		margin-block: 0.35rem 0.55rem;
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		line-height: 1.25;
	}

	.school-list-card h2 a {
		color: var(--color-text);
		text-decoration: none;
	}

	.school-list-card p {
		color: var(--color-text-secondary);
		line-height: 1.65;
	}

	@media (max-width: 640px) {
		.school-list-card {
			grid-template-columns: 1fr;
		}
	}
</style>
