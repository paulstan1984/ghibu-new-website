---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import SchoolForm from "../components/SchoolForm.astro";

const { entries, error, cacheHint } = await getEmDashCollection("pages", {
	limit: 100,
	orderBy: { title: "asc" },
});
if (error) return new Response("Nu am putut încărca informațiile despre admitere.", { status: 500 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pages = entries.filter((entry) =>
	(entry.id + " " + entry.data.title).toLocaleLowerCase("ro").match(
		/admit|inscr|înscr|transfer|pregat|pregăt|clasa-a-9|clasa-a-ix/,
	),
);
---

<Base title="Admitere" description="Informații despre admitere și înscriere la Liceul Teoretic „Onisifor Ghibu”.">
	<header class="band intro">
		<div class="frame school-page-intro">
			<p class="eyebrow">Următorul pas</p>
			<h1 class="intro__title">Admitere și înscriere</h1>
			<p class="intro__lead">Informații pentru viitorii elevi și familiile lor.</p>
		</div>
	</header>
	<section class="band section">
		<div class="frame school-admission">
			<div class="school-admission__intro">
				<p class="eyebrow">Bine ai venit</p>
				<h2>Descoperă ce ți se potrivește</h2>
				<p>
					Consultă anunțurile și documentele publicate de liceu pentru
					informațiile actualizate despre admitere, înscriere și transfer.
				</p>
				<a class="btn" href="/documente">Vezi documentele</a>
			</div>
			<div class="school-admission__links">
				{pages.length ? pages.map((entry) => (
					<a href={`/${entry.id}`}>
						<span>{entry.data.title}</span><span aria-hidden="true">→</span>
					</a>
				)) : <p class="school-empty">Anunțurile de admitere vor fi publicate aici.</p>}
			</div>
		</div>
	</section>
	<section class="band section">
		<div class="frame school-admission-form">
			<SchoolForm variant="welcome" />
		</div>
	</section>
</Base>

<style>
	.school-admission {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 5vw, 5rem);
	}

	.school-admission__intro h2 {
		margin-block: 0.35rem 0.8rem;
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		line-height: 1.1;
	}

	.school-admission__intro > p:not(.eyebrow) {
		margin-bottom: 1.5rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
	}

	.school-admission__links {
		display: grid;
		align-content: start;
		gap: 0.5rem;
	}

	.school-admission__links a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.2rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: var(--color-text);
		font-weight: 650;
		text-decoration: none;
	}

	.school-admission__links a:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.school-admission-form {
		max-width: 760px;
	}

	@media (max-width: 720px) {
		.school-admission {
			grid-template-columns: 1fr;
		}
	}
</style>
