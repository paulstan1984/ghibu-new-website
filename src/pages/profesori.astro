---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const { entries, error, cacheHint } = await getEmDashCollection("teachers", {
	orderBy: { title: "asc" },
	limit: 100,
});
if (error) return new Response("Nu am putut încărca profesorii.", { status: 500 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Profesori" description="Cadrele didactice ale Liceului Teoretic „Onisifor Ghibu”.">
	<header class="band intro">
		<div class="frame school-page-intro">
			<p class="eyebrow">Oameni care inspiră</p>
			<h1 class="intro__title">Profesorii noștri</h1>
			<p class="intro__lead">Cunoaște echipa care îi sprijină pe elevi să descopere și să crească.</p>
		</div>
	</header>
	<section class="band section">
		<div class="frame school-people-grid">
			{entries.length ? entries.map((teacher) => (
				<article class="school-person-card">
					<a class="school-person-card__title" href={`/profesori/${teacher.id}`}>
						<h2>{teacher.data.title}</h2>
					</a>
					{teacher.data.excerpt && <p>{teacher.data.excerpt}</p>}
					<a class="text-link" href={`/profesori/${teacher.id}`}>Vezi profilul <span aria-hidden="true">→</span></a>
				</article>
			)) : <p class="school-empty">Profilurile profesorilor vor fi adăugate aici.</p>}
		</div>
	</section>
</Base>

<style>
	.school-people-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.school-person-card {
		display: flex;
		min-height: 13rem;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.school-person-card__title {
		color: var(--color-text);
		text-decoration: none;
	}

	.school-person-card h2 {
		font-size: 1.3rem;
		line-height: 1.3;
	}

	.school-person-card p {
		margin-top: 0.6rem;
		color: var(--color-text-secondary);
		line-height: 1.6;
	}

	.school-person-card .text-link {
		margin-top: auto;
	}

	@media (max-width: 850px) {
		.school-people-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.school-people-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
